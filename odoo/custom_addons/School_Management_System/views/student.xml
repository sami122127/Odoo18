<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!-- Tree view of Student Management model(start) -->
<record id="view_student_management_list" model="ir.ui.view">
    <field name="name">Student.Management.list</field>
    <field name="model">student.management</field>
    <field name="arch" type="xml">
     <list>
       <field name="name"/>
       <field name="student_id"/>
       <field name="dob"/>
       <field name="gender" widget="badge" decoration-success="gender == 'male'" decoration-warning="gender == 'female'"/>
     </list> 
   </field>
</record>
<!-- Tree view of Student Management model(end) -->

<!-- Form view of Student Management model(start) -->
<record id="view_student_management_form" model="ir.ui.view">
    <field name="name">Student Management form</field>
    <field name="model">student.management</field>
    <field name="arch" type="xml">
     <form>
       <header>
        <button name="print_something" string="Click" class="oe_highlight" type="object"/>
        <button name="show_rainbow" string="Show Rainbow" type="object" class="oe_highlight"/>
        <button name="send_email" string="Send Email" type="object" class="oe_highlight"/>
       </header>
      <sheet>
       <field name="image" widget="image" class="oe_avatar"/>
       <group>
         <field name="name"/>
         <field name="student_id"/>
         <field name="dob"/>
         <field name="gender" />
         <field name="admission_date"/>

         <notebook>
           <page string="Personal Information">
           <group>
             <field name="email"/>
             <field name="phone"/>
             <field name="address"/>
             </group>
           </page>
           <page string="Guardian Information">
             <group>
              <field name="guardian_name"/>
              <field name="guardian_phone"/>
             </group>
           </page>
         </notebook>
       </group>
      </sheet>
     </form> 
   </field>
</record>
<!-- Form view of Student Management model(end) -->

<!--Kanban view of studdent managemnent model(start)-->
 


<!-- Kanban View of Student Management -->
<record id="view_student_management_kanban" model="ir.ui.view">
    <field name="name">student.management.kanban</field>
    <field name="model">student.management</field>
    <field name="arch" type="xml">
        <kanban>
            
            <field name="gender"/>
            <templates>
                <t t-name="card">
                    <div class="oe_kanban_global_click">
                        <div class="d-flex align-items-center gap-3">

                            <!-- Student Image -->
                            <field name="image"
                                   widget="image"
                                   options="{'size': [100, 100]}"/>

                            <!-- Student Details -->
                            <div>
                                <strong>
                                    <field name="name"/>
                                </strong>

                                <div>
                                    Student ID:
                                    <field name="student_id"/>
                                </div>

                                <div>
                                    Date of Birth:
                                    <field name="dob"/>
                                </div>

                               <div>
                                    <t t-if="record.gender.raw_value == 'male'">
                                        <p class="badge text-bg-success">Male</p>
                                    </t>
                                    <t t-elif="record.gender.raw_value == 'female'">
                                        <p class="badge text-bg-warning">Female</p>
                                    </t>
                                </div>
                            </div>

                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>


<!--Kanban view of studdent managemnent model(end) -->

<!--Search view of Student Management model(start) -->
<record id="view_student_management_search" model="ir.ui.view">
    <field name="name">Student Management search</field>
    <field name="model">student.management</field>
    <field name="arch" type="xml">
     <search>
       <field name="name"/>
       <field name="student_id"/>
       <filter name="filter_by_male" string="Male" domain="[('gender','=','male')]"/>
       <separator/>
       <filter name="filter_by_female" string="Female" domain="[('gender','=','female')]"/>

       <filter name="group_by_gender" string="Gender" context="{'group_by': 'gender'}"/>
      </search> 
   </field>
</record>

<!--Search view of Student Management model(end) -->

<!-- Action of Student Management model(start) -->
 <record id="student_management_action" model="ir.actions.act_window">
   <field name="name">Students</field>
   <field name="res_model">student.management</field>
   <field name="view_mode">list,form,kanban</field>
 </record>
<!-- Action of Student Management model(end) -->
</odoo>